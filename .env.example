# Supabase PostgreSQL: Connect -> Session pooler -> URI
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DATABASE_POOL_MAX=5
# DATABASE_SSL_CA_FILE=C:/path/to/prod-supabase.cer
# Optional separate direct/session URI for migrations:
# MIGRATION_DATABASE_URL=

# Supabase Storage — upload хийсэн зургууд (Vercel дээр заавал). Project Settings -> API.
# Service role түлхүүр зөвхөн сервер талд; NEXT_PUBLIC_ угтвар хэзээ ч бүү тавь.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=uploads
